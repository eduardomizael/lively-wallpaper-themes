{
  "labelAtmosphere": {
    "type": "label",
    "value": "Ambiente e paisagem"
  },
  "celestialMotion": {
    "type": "checkbox",
    "value": true,
    "text": "Mover Sol e Lua conforme o horário",
    "help": "Composição panorâmica: leste à esquerda, sul ao centro e oeste à direita. Requer localidade e dia/noite ativos."
  },
  "ambientLanterns": {
    "type": "checkbox",
    "value": true,
    "text": "Iluminação das lanternas conforme o ambiente"
  },
  "moonDimsStars": {
    "type": "checkbox",
    "value": true,
    "text": "Luar reduz a visibilidade das estrelas"
  },
  "windGusts": {
    "type": "checkbox",
    "value": true,
    "text": "Rajadas suaves de vento"
  },
  "gustStrength": {
    "type": "slider",
    "value": 50,
    "min": 0,
    "max": 100,
    "step": 5,
    "text": "Variação das rajadas (%)"
  },
  "transitionSeconds": {
    "type": "slider",
    "value": 20,
    "min": 1,
    "max": 120,
    "step": 1,
    "text": "Duração das transições (segundos)"
  },
  "stormLightning": {
    "type": "checkbox",
    "value": true,
    "text": "Relâmpagos distantes em tempestades"
  },
  "lightningIntensity": {
    "type": "slider",
    "value": 25,
    "min": 0,
    "max": 100,
    "step": 5,
    "text": "Intensidade dos relâmpagos (%)"
  },
  "scenery": {
    "type": "dropdown",
    "value": 3,
    "text": "Paisagem",
    "items": [
      "Lago, montanhas e portal",
      "Lago e montanhas",
      "Montanhas",
      "Somente céu",
      "Montanhas e floresta"
    ]
  },
  "labelDemo": {
    "type": "label",
    "value": "Demonstração"
  },
  "demoMode": {
    "type": "dropdown",
    "value": 0,
    "text": "Experimentar cenário",
    "items": [
      "Condições reais",
      "Dia limpo",
      "Pôr do sol",
      "Noite limpa",
      "Chuva",
      "Tempestade",
      "Neve",
      "Neblina",
      "Noite de Lua cheia",
      "Amanhecer"
    ],
    "help": "Demonstração funciona sem internet. Volte a “Condições reais” para acompanhar sua localidade."
  },
  "demoMoonPhase": {
    "type": "slider",
    "value": 50,
    "min": 0,
    "max": 100,
    "step": 1,
    "text": "Fase da Lua na demonstração (%)",
    "help": "0/100 nova; 25 quarto crescente; 50 cheia; 75 quarto minguante. O cenário Lua cheia fixa a fase em 50."
  },
  "labelLocal": {
    "type": "label",
    "value": "Clima e Lua locais"
  },
  "weatherAuto": {
    "type": "checkbox",
    "value": true,
    "text": "Ativar condições locais",
    "help": "Informe a cidade abaixo. Desligue para restaurar o céu manual."
  },
  "localCity": {
    "type": "textbox",
    "value": "",
    "text": "Cidade",
    "help": "Exemplo: Goiânia. A consulta começa após você preencher este campo."
  },
  "localCountry": {
    "type": "textbox",
    "value": "BR",
    "text": "Código do país",
    "help": "Duas letras: BR, PT, US. Vazio para pesquisar todos os países."
  },
  "localResult": {
    "type": "slider",
    "value": 1,
    "min": 1,
    "max": 10,
    "step": 1,
    "text": "Local encontrado",
    "help": "Escolha outro resultado se houver cidades homônimas. Confira o nome completo no painel do wallpaper."
  },
  "weatherInterval": {
    "type": "slider",
    "value": 30,
    "min": 5,
    "max": 180,
    "step": 5,
    "text": "Consultar clima a cada (minutos)"
  },
  "weatherProvider": {
    "type": "dropdown",
    "value": 0,
    "text": "Fonte meteorológica",
    "items": [
      "WeatherAPI, com reserva Open-Meteo",
      "Open-Meteo"
    ],
    "help": "Sem chave WeatherAPI, usa Open-Meteo. Em caso de falha, a reserva é automática."
  },
  "weatherApiKey": {
    "type": "textbox",
    "value": "",
    "text": "Chave WeatherAPI",
    "help": "Cadastre-se em weatherapi.com e cole a chave aqui. O Lively salva este campo localmente."
  },
  "radarEnabled": {
    "type": "checkbox",
    "value": true,
    "text": "Usar RainViewer para chuva próxima",
    "help": "Ecos recentes podem ativar chuva perto do centro da cidade. Ausência de eco não garante tempo seco. Fonte e créditos disponíveis no painel completo."
  },
  "radarInterval": {
    "type": "slider",
    "value": 5,
    "min": 5,
    "max": 30,
    "step": 5,
    "text": "Consultar radar a cada (minutos)"
  },
  "localRefresh": {
    "type": "button",
    "value": "Atualizar agora",
    "text": "Consultar clima agora"
  },
  "localDayNight": {
    "type": "checkbox",
    "value": true,
    "text": "Acompanhar dia e noite",
    "help": "Desligado: mantém o céu noturno com o clima local."
  },
  "localMoon": {
    "type": "checkbox",
    "value": true,
    "text": "Fase e orientação reais da Lua",
    "help": "Fase e orientação locais. Ative “Mover Sol e Lua” para acompanhar a posição panorâmica no céu."
  },
  "localWind": {
    "type": "checkbox",
    "value": true,
    "text": "Vento local nas nuvens e lanternas"
  },
  "localPrecipitation": {
    "type": "checkbox",
    "value": true,
    "text": "Efeitos de chuva e neve"
  },
  "localStatus": {
    "type": "checkbox",
